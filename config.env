# Settings read by hollowroot.sh. Plain shell syntax.

# Link to the GSI archive (.7z, .zip, .xz or a raw .img).
# Paste your own link here to use a different build. The default is the
# LineageOS 23.2 vanilla ext4 build from 2026-05-24 by MisterZtr.
# Use an ext4 image, the loader mounts it with ext4 and EROFS builds will not work.
GSI_URL="https://sourceforge.net/projects/misterztr-gsi/files/LineageOS/Android%2016/LineageOS-23.2-20260524-VANILLA-EXT4-GSI.7z/download"

# Optional sha256 of the downloaded archive. Leave empty to skip the check.
# This value matches the default GSI_URL above.
GSI_SHA256="4eba20225472917923c4ba6f2367ba99babcd4c847b03ddd97c315745c54c2da"

# Already have an extracted image? Point to it and fetch will do nothing.
GSI_IMG=""

# Android NDK used by `make`. Leave empty if ANDROID_NDK_HOME is set.
NDK=""

# adb serial, only needed when more than one device is connected.
ADB_SERIAL=""
